# ---- Environment ----
# development | production   (production enforces sslmode=require, NullPool and non-default secrets)
ENVIRONMENT=development

# ---- Database ----
# Running app. Local: the docker-compose postgres. Production: Supabase TRANSACTION pooler (port 6543), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://tahadi:tahadi@localhost:5432/tahadi
# Alembic migrations. Production: Supabase SESSION pooler or direct connection (port 5432), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
MIGRATIONS_DATABASE_URL=
# Force NullPool on/off (defaults to on in production, required for the transaction pooler)
# DB_NULLPOOL=true

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
# Optional regex for Vercel preview deployments
CORS_ORIGIN_REGEX=https://tahadi-.*\.vercel\.app

# ---- Seed (python -m app.db.seed) ----
SEED_ADMIN_EMAIL=admin@tahadi.app
SEED_ADMIN_PASSWORD=
# Password for the demo trainers and clients (required in production unless --admin-only)
SEED_DEMO_PASSWORD=
