# ============================================================
# Tahadi — .env.example
# Copy to `.env` locally and fill with REAL values. Never commit .env.
# Every value below is a FAKE placeholder. Do not put real secrets here.
# ============================================================

# ---------- Backend (FastAPI) ----------
# Secret used to sign JWTs. Use a long random string in real deployments.
JWT_SECRET=change-me-to-a-long-random-secret-string

# Access token lifetime in minutes.
JWT_EXPIRES_MINUTES=60

# Comma-separated list of allowed origins for CORS (Render frontend URL, local dev).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Environment: development | production
APP_ENV=development

# ---------- Database (Supabase PostgreSQL) ----------
# Use the direct connection string for PostgreSQL, not the pooler, for simplicity.
# We use Supabase ONLY as a managed PostgreSQL database.
DATABASE_URL=postgresql://postgres.example:supabase-password@db.example.supabase.co:5432/postgres

# ---------- Frontend (React) ----------
# Base URL of the backend API (where this app is served).
VITE_API_BASE_URL=http://localhost:8000

# ---------- Seeding ----------
# Master passphrase/flag used by the coach seeding script.
SEED_COACH_PASSPHRASE=change-me-seed-passphrase

# ---------- Supabase Auth ----------
# JWT secret Supabase uses to sign access tokens. Fake placeholder only.
SUPABASE_JWT_SECRET=change-me-supabase-jwt-secret
# Public anon key from the Supabase project. Fake placeholder only.
SUPABASE_ANON_KEY=change-me-supabase-anon-key
