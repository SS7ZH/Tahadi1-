# -------------------------------------------------
# Combined .gitignore (Muhanad + Saad)
# -------------------------------------------------

# ---------- Environment / secrets ----------
# Real env files are ignored; the example file is kept.
.env
.env.*
!.env.example

# ---------- Python (backend) ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
*.egg
.venv/
venv/
env/
ENV/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
*.log

# ---------- Node (frontend) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.yarn/
.pnpm-store/
.dist/
build/
.vite/
*.tsbuildinfo
.eslintcache
.cache/

# ---------- Render / deploy artifacts ----------
*.render.yaml.local

# ---------- Editors / IDE ----------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
.zed/

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Misc ----------
*.swp
*~
*.tmp
*.bak
